pipeline {
    agent any

    parameters {
        choice(
            name: 'TARGET_ENV',
            choices: ['main', 'dev'],
            description: 'Environment to deploy'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: 'v1.0',
            description: 'Docker image tag'
        )
    }

    stages {
        stage('Deploy') {
            steps {
                script {
                    def imageName
                    def containerName
                    def port

                    if (params.TARGET_ENV == 'main') {
                        imageName = 'nodemain'
                        containerName = 'node-main'
                        port = '3000'
                    } else {
                        imageName = 'nodedev'
                        containerName = 'node-dev'
                        port = '3001'
                    }

                    sh """
                        docker image inspect ${imageName}:${params.IMAGE_TAG}

                        docker rm -f ${containerName} 2>/dev/null || true

                        docker run -d \
                          --name ${containerName} \
                          --expose 3000 \
                          -p ${port}:3000 \
                          ${imageName}:${params.IMAGE_TAG}
                    """
                }
            }
        }
    }
}
